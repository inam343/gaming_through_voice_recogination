<Window x:Class="GamingThroughVoiceRecognitionSystem.Views.GlassMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message"
        Height="250"
        Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Grid>
        <!-- Backdrop with shadow -->
        <Border CornerRadius="20" Background="{DynamicResource GlassBackgroundBrush}" 
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="2" Padding="30">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Icon -->
                <TextBlock Text="ℹ️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                
                <!-- Message Text -->
                <TextBlock x:Name="MessageText" 
                           Text="Default message"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="380"
                           Margin="0,0,0,25"/>
                
                <!-- OK Button -->
                <Button x:Name="okBtn"
                        Content="OK"
                        Width="120"
                        Height="40"
                        Click="OkBtn_Click"
                        Background="{DynamicResource PrimaryGradientBrush}"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="16"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
